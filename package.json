{
  "name": "crash-game",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:prune": "docker compose down -v --remove-orphans --rmi local"
  },
  "devDependencies": {
    "bun-types": "latest",
    "knip": "latest"
  }
}
