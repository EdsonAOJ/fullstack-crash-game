generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoundStatus {
  WAITING_FOR_BETS
  RUNNING
  CRASHED
  COMPLETED
}

enum BetStatus {
  PENDING_DEBIT
  ACCEPTED
  REJECTED
  CASHED_OUT_PENDING_CREDIT
  CASHED_OUT
  LOST
}

model Round {
  id                       String      @id @default(uuid())
  status                   RoundStatus
  crashPointMultiplier     Int
  currentMultiplier        Int

  serverSeed               String
  serverSeedHash           String
  publicSeed               String
  nonce                    Int

  startsAt                 DateTime
  startedAt                DateTime?
  crashedAt                DateTime?
  completedAt              DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  bets Bet[]

  @@index([status])
  @@index([createdAt])
  @@index([nonce])
  @@map("rounds")
}

model Bet {
  id                    String    @id @default(uuid())
  roundId               String
  playerId              String
  amountCents           BigInt
  status                BetStatus
  autoCashoutMultiplier Int?
  cashoutMultiplier     Int?
  payoutCents           BigInt?
  rejectionReason       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  round Round @relation(fields: [roundId], references: [id])

  @@unique([roundId, playerId])
  @@index([roundId])
  @@index([playerId])
  @@index([status])
  @@map("bets")
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id          String            @id @default(uuid())
  eventId     String            @unique
  eventName   String
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  lockedAt    DateTime?
  publishedAt DateTime?
  lastError   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("outbox_events")
}

model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventName   String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("processed_events")
}

